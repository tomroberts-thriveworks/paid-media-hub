# Copy to .env and fill in on the machine that will run this. NEVER commit .env.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) account ID, digits only
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Account(s) to report on, comma-separated, digits only
GOOGLE_ADS_CUSTOMER_IDS=
DATABASE_URL=sqlite:///data/paidmedia.db
